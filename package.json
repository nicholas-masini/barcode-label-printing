{
  "name": "barcode-label-printing",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,print -c blue,green \"vite\" \"node server/index.js\"",
    "dev:web": "vite",
    "dev:server": "node server/index.js",
    "build": "tsc && vite build",
    "start": "node server/index.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "jsbarcode": "^3.12.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/jsbarcode": "^3.3.10",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^10.0.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
